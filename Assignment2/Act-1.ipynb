    "from haversine import haversine, Unit\n",
    "\n",
    "# Question 4. b)\n",
    "def parse_polyline(polyline):\n",
    "    pts = json.loads(polyline)\n",
    "    return [[float(lon), float(lat)] for lon, lat in pts]\n",
    "\n",
    "print(df_clean[0])\n",
    "\n",
    "\n",
    "def get_trip_duration(polyline):\n",
    "    \"\"\"\n",
    "    Returns the duration of a trip (in seconds) thanks to its polyline (gps coordinates are samples at 15-second intervals)\n",
    "    \"\"\"\n",
    "    return len(polyline)*15\n",
    "\n",
    "def get_distance_trip(polyline):\n",
    "    \"\"\"\n",
    "    Returns the distance of a trip in meters using the harvesine formula\n",
    "    \"\"\"\n",
    "    distance = 0\n",
    "    for i in range(len(polyline) - 1):\n",
    "        distance += haversine(parse_polyline(polyline[i]), parse_polyline(polyline[i+1]), unit=Unit.METERS)\n",
    "    return distance\n",
    "\n",
    "df_clean[\"TRIP_DURATION\"] = df_clean[\"POLYLINE\"].apply(get_trip_duration)\n",
    "# df_clean[\"TRIP_DISTANCE\"] = df_clean[\"POLYLINE\"].apply(get_distance_trip)\n",
    "\n",
    "call_types_stats =  (\n",
    "    df_clean.groupby(\"CALL_TYPE\", observed=True)\n",
    "    .agg(\n",
    "        AVG_TRIP_DURATION=(\"TRIP_DURATION\", \"mean\"),\n",
    "        AVG_TRIP_DISTANCE=(\"TRIP_DISTANCE\", \"mean\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# print(call_types_stats)"
   ]
