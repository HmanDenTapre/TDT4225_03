    "\n",
    "        self.cursor.execute(\"SELECT COUNT(*) FROM trips\")\n",
    "        print(self.cursor.fetchall())\n",
    "\n",
    "        # Takes a while\n",
    "        #self.cursor.execute(\"SELECT COUNT(*) FROM points\")\n",
    "        #print(self.cursor.fetchall())\n",
    "\n",
    "    def exercise_1(self):\n",
    "        queries = [\n",
    "            (\"\"\"\n",
    "                SELECT\n",
    "                    COUNT(DISTINCT taxi_id)\n",
    "                FROM trips\n",
    "            \"\"\"),\n",
    "            (\"\"\"\n",
    "                SELECT\n",
    "                    COUNT(DISTINCT trip_id)\n",
    "                FROM trips\n",
    "            \"\"\"),\n",
    "            (\"\"\"\n",
    "                SELECT\n",
    "                    COUNT(trip_id)\n",
    "                FROM points\n",
    "            \"\"\")\n",
    "        ]\n",
    "\n",
    "        for query in queries:\n",
    "            self.cursor.execute(query)\n",
    "            midnight_crossers = self.cursor.fetchall()\n",
    "            print(tabulate(midnight_crossers[:10], headers=self.cursor.column_names))\n",
    "\n",
    "    def exercise_2(self):\n",
    "        query = \"\"\"\n",
    "                    SELECT\n",
    "                        AVG(nb_trips_per_taxi) AS avg_trips_per_taxi\n",
    "                    FROM (\n",
    "                        SELECT\n",
    "                            COUNT(DISTINCT trip_id) as nb_trips_per_taxi\n",
    "                        FROM trips\n",
    "                        GROUP BY taxi_id\n",
    "                    ) AS t;\n",
    "                \"\"\"\n",
    "\n",
    "        self.cursor.execute(query)\n",
    "        midnight_crossers = self.cursor.fetchall()\n",
    "        print(tabulate(midnight_crossers[:10], headers=self.cursor.column_names))\n",
    "\n",
    "    def exercise_3(self):\n",
    "        query = \"\"\"\n",
    "                    SELECT\n",
    "                        taxi_id,\n",
    "                        COUNT(DISTINCT trip_id) as nb_trips_per_taxi\n",
    "                    FROM trips\n",
    "                    GROUP BY taxi_id\n",
    "                    ORDER BY nb_trips_per_taxi DESC\n",
    "                    LIMIT 20\n",
    "                \"\"\"\n",
    "\n",
    "        self.cursor.execute(query)\n",
    "        midnight_crossers = self.cursor.fetchall()\n",
    "        print(tabulate(midnight_crossers[:10], headers=self.cursor.column_names))\n",
    "\n",
    "    def exercise_4_a(self):\n",
    "        query = \"\"\"\n",
    "                    SELECT\n",
    "                        taxi_id,\n",
    "                        CASE\n",
    "                            WHEN nb_calls_type_A >= nb_calls_type_B AND nb_calls_type_A >= nb_calls_type_C THEN\n",
    "                                'A'\n",
    "                            WHEN nb_calls_type_B >= nb_calls_type_A AND nb_calls_type_B >= nb_calls_type_C THEN\n",
    "                                'B'\n",
    "                            ELSE 'C'\n",
    "                        END AS most_used_call_type\n",
    "                    FROM(\n",
    "                        SELECT\n",
    "                            taxi_id,\n",
    "                            SUM(CASE WHEN call_type='A' THEN 1 ELSE 0 END) AS nb_calls_type_A,\n",
    "                            SUM(CASE WHEN call_type='B' THEN 1 ELSE 0 END) AS nb_calls_type_B,\n",
    "                            SUM(CASE WHEN call_type='C' THEN 1 ELSE 0 END) AS nb_calls_type_C\n",
    "                        FROM trips\n",
    "                        GROUP BY taxi_id\n",
    "                    ) AS t\n",
    "                \"\"\"\n",
    "\n",
    "        self.cursor.execute(query)\n",
    "        midnight_crossers = self.cursor.fetchall()\n",
    "        print(tabulate(midnight_crossers[:10], headers=self.cursor.column_names))\n",
    "\n",
    "    def exercise_4_b(self):\n",
    "        query1 = \"\"\"\n",
    "                    SELECT\n",
    "                        t.trip_id,\n",
    "                        t.call_type,\n",
    "                        JSON_ARRAYAGG(\n",
    "                            JSON_ARRAY(p.longitude, p.latitude)\n",
    "                        ) AS list_points\n",
    "                    FROM trips t\n",
    "                    JOIN points p\n",
    "                        ON p.trip_id = t.trip_id\n",
    "                    GROUP BY t.trip_id, t.call_type\n",
    "                    ORDER BY t.trip_id\n",
    "                \"\"\"\n",
    "\n",
    "        self.cursor.execute(query1)\n",
    "        data = self.cursor.fetchall()\n",
    "        durations = {'A': [], 'B': [], 'C': []}\n",
    "        distances = {'A': [], 'B': [], 'C': []}\n",
    "        for row in data:\n",
    "            type = row[1]\n",
    "            points = json.loads(row[2])\n",
    "            durations[type].append(len(points)*15)    # The number of points multiplied by 15 gives the duration of the trip in seconds since the coordinates are sampled every 15 seconds\n",
    "            distance = 0\n",
    "            for i in range(len(points)-1):\n",
    "                distance += hv.haversine(points[i], points[i+1], unit=\"m\")\n",
    "            distances[type].append(distance)\n",
    "\n",
    "        for key, value in durations.items():\n",
    "            print(f\"Mean duration of trips of type {key}: {round(np.mean(value), 2)} seconds\")\n",
    "\n",
    "        print(\"\\n\")\n",
    "\n",
    "        for key, value in distances.items():\n",
    "            print(f\"Mean distance of trips of type {key}: {round(np.mean(value), 2)} meters\")\n",
    "\n",
    "        print(\"\\n\")\n",
    "\n",
    "        query2 = \"\"\"\n",
    "                    SELECT\n",
    "                        CASE\n",
    "                            WHEN HOUR(start_time) >= 0 AND HOUR(start_time) < 6 THEN '00-06'\n",
    "                            WHEN HOUR(start_time) >= 6 AND HOUR(start_time) < 12 THEN '06-12'\n",
    "                            WHEN HOUR(start_time) >= 12 AND HOUR(start_time) < 18 THEN '12-18'\n",
    "                            ELSE '18-24'\n",
    "                        END AS time_band,\n",
    "                    COUNT(*) AS trip_count\n",
    "                    FROM trips\n",
    "                    GROUP BY\n",
    "                        CASE\n",
    "                            WHEN HOUR(start_time) >= 0 AND HOUR(start_time) < 6 THEN '00-06'\n",
    "                            WHEN HOUR(start_time) >= 6 AND HOUR(start_time) < 12 THEN '06-12'\n",
    "                            WHEN HOUR(start_time) >= 12 AND HOUR(start_time) < 18 THEN '12-18'\n",
    "                            ELSE '18-24'\n",
    "                        END\n",
    "                \"\"\"\n",
    "        \n",
    "        self.cursor.execute(query2)\n",
    "        data = self.cursor.fetchall()\n",
    "        for time_band, nb_trips in data:\n",
    "            print(f\"Number of trips during time band {time_band}: {nb_trips}\")\n",
    "            \n",
    "        def exercise_5(self):\n",
    "\n",
    "            print(\"\\n--- Exercise 5: Taxis by Total Hours and Distance ---\")\n",
    "            \n",
    "            trips_cache = \"trips_cache.csv\"\n",
    "            points_cache = \"points_cache.csv\"\n",
    "            \n",
    "            # 1. Fetch or load 'trips'\n",
    "            if os.path.exists(trips_cache):\n",
    "                print(\"Loading 'trips' from local cache...\")\n",
    "                df_trips = pd.read_csv(trips_cache)\n",
    "            else:\n",
    "                print(\"Fetching 'trips' from MySQL...\")\n",
    "                self.cursor.execute(\"SELECT trip_id, taxi_id FROM trips\")\n",
    "                df_trips = pd.DataFrame(self.cursor.fetchall(), columns=[\"trip_id\", \"taxi_id\"])\n",
    "                df_trips.to_csv(trips_cache, index=False)\n",
    "\n",
    "            # 2. Fetch or load 'points'\n",
    "            if os.path.exists(points_cache):\n",
    "                print(\"Loading 'points' from local cache...\")\n",
    "                df_points = pd.read_csv(points_cache)\n",
    "            else:\n",
    "                print(\"Fetching 'points' from MySQL (one-time fetch)...\")\n",
    "                self.cursor.execute(\"SELECT trip_id, point_idx, latitude, longitude FROM points\")\n",
    "                df_points = pd.DataFrame(self.cursor.fetchall(), columns=[\"trip_id\", \"point_idx\", \"latitude\", \"longitude\"])\n",
    "                df_points.to_csv(points_cache, index=False)\n",
    "\n",
    "            print(\"Processing trajectories in Pandas...\")\n",
    "\n",
    "            # Sort trajectories chronologically\n",
    "            df_points.sort_values(by=[\"trip_id\", \"point_idx\"], inplace=True)\n",
    "\n",
    "            # Calculate distance using vectorized shifting\n",
    "            df_points[\"prev_lat\"] = df_points[\"latitude\"].shift(1)\n",
    "            df_points[\"prev_lon\"] = df_points[\"longitude\"].shift(1)\n",
    "            df_points[\"prev_trip_id\"] = df_points[\"trip_id\"].shift(1)\n",
    "\n",
    "            same_trip_mask = df_points[\"trip_id\"] == df_points[\"prev_trip_id\"]\n",
    "\n",
    "            def haversine_np(lat1, lon1, lat2, lon2):\n",
    "                R = 6371.0  # Earth radius in kilometers\n",
    "                lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n",
    "                dlat = lat2 - lat1\n",
    "                dlon = lon2 - lon1\n",
    "                a = np.sin(dlat / 2.0)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon / 2.0)**2\n",
    "                return 2 * R * np.arcsin(np.sqrt(a))\n",
    "\n",
    "            df_points[\"distance_km\"] = 0.0\n",
    "            df_points.loc[same_trip_mask, \"distance_km\"] = haversine_np(\n",
    "                df_points.loc[same_trip_mask, \"prev_lat\"],\n",
    "                df_points.loc[same_trip_mask, \"prev_lon\"],\n",
    "                df_points.loc[same_trip_mask, \"latitude\"],\n",
    "                df_points.loc[same_trip_mask, \"longitude\"]\n",
    "            )\n",
    "\n",
    "            # Merge taxi metadata and aggregate\n",
    "            df_merged = df_points.merge(df_trips, on=\"trip_id\", how=\"inner\")\n",
    "\n",
    "            stats = df_merged.groupby(\"taxi_id\").agg(\n",
    "                total_points=(\"point_idx\", \"count\"),\n",
    "                total_distance_km=(\"distance_km\", \"sum\")\n",
    "            ).reset_index()\n",
    "\n",
    "            stats[\"total_hours\"] = (stats[\"total_points\"] * 15.0) / 3600.0\n",
    "            stats.sort_values(by=\"total_hours\", ascending=False, inplace=True)\n",
    "\n",
    "            top_20 = stats[[\"taxi_id\", \"total_hours\", \"total_distance_km\"]].head(20)\n",
    "            print(tabulate(top_20, headers=[\"taxi_id\", \"total_hours\", \"total_distance_km\"], floatfmt=\".2f\"))\n",
    "    \n",
    "    def exercise_6(self):\n",
    "        # ST_Distance_Sphere takes (longitude, latitude) and returns distance in meters.\n",
    "        # We use DISTINCT to only count each trip once, even if multiple points fall within 100m.\n",
    "        query = \"\"\"\n",
    "            SELECT DISTINCT t.trip_id\n",
    "            FROM trips t\n",
    "            JOIN points p ON t.trip_id = p.trip_id\n",
    "            WHERE ST_Distance_Sphere(\n",
    "                POINT(p.longitude, p.latitude),\n",
    "                POINT(-8.62911, 41.15794)\n",
    "            ) <= 100\n",
    "            LIMIT 20;\n",
    "        \"\"\"\n",
    "        \n",
    "        print(\"\\n--- Exercise 6: Trips within 100m of Porto City Hall ---\")\n",
    "        self.cursor.execute(query)\n",
    "        results = self.cursor.fetchall()\n",
    "        print(tabulate(results, headers=self.cursor.column_names))\n",
    "        \n",
    "        # To get the total count instead of a list, you can use:\n",
    "        count_query = \"\"\"\n",
    "            SELECT COUNT(DISTINCT t.trip_id) AS total_trips\n",
    "            FROM trips t\n",
    "            JOIN points p ON t.trip_id = p.trip_id\n",
    "            WHERE ST_Distance_Sphere(POINT(p.longitude, p.latitude), POINT(-8.62911, 41.15794)) <= 100;\n",
    "        \"\"\"\n",
    "        self.cursor.execute(count_query)\n",
    "        print(f\"\\nTotal number of trips near City Hall: {self.cursor.fetchone()[0]}\")\n",
    "\n",
    "\n",
    "    def exercise_7(self):\n",
    "        # We use a LEFT JOIN to ensure we also capture trips that were registered \n",
    "        # in the 'trips' table but have exactly 0 points in the 'points' table.\n",
    "        query = \"\"\"\n",
    "            SELECT COUNT(*) AS invalid_trips_count\n",
    "            FROM (\n",
    "                SELECT t.trip_id\n",
    "                FROM trips t\n",
    "                LEFT JOIN points p ON t.trip_id = p.trip_id\n",
    "                GROUP BY t.trip_id\n",
    "                HAVING COUNT(p.point_idx) < 3\n",
    "            ) AS invalid_counts;\n",
    "        \"\"\"\n",
    "        \n",
    "        print(\"\\n--- Exercise 7: Number of Invalid Trips (< 3 GPS points) ---\")\n",
    "        self.cursor.execute(query)\n",
    "        result = self.cursor.fetchone()\n",
    "        print(f\"Invalid trips found: {result[0]}\")\n",
    "\n",
    "    def exercise_8(self):\n",
    "        query_fake = \"\"\" SELECT \n",
    "                        trip_id,\n",
    "                        start_time,\n",
    "                        estimated_end_time\n",
    "                    FROM (\n",
    "                        SELECT\n",
    "                            t.trip_id,\n",
    "                            t.start_time,\n",
    "                            DATE_ADD(\n",
    "                                t.start_time,\n",
    "                                INTERVAL (COUNT(p.point_idx) - 1) * 15 SECOND\n",
    "                            ) AS estimated_end_time\n",
    "                        FROM trips t\n",
    "                        JOIN points p ON t.trip_id = p.trip_id\n",
    "                        WHERE t.missing_data = 0\n",
    "                        GROUP BY t.trip_id, t.start_time\n",
    "                    ) AS trip_data\n",
    "                    WHERE DATE(t.start_time) < DATE(estimated_end_time)\n",
    "                    ORDER BY start_time\n",
    "                \"\"\"\n",
    "\n",
    "        query = \"\"\"\n",
    "                    SELECT\n",
    "                        t.trip_id,\n",
    "                        t.start_time,\n",
    "                        DATE_ADD(\n",
    "                            t.start_time,\n",
    "                            INTERVAL last_point.point_idx * 15 SECOND\n",
    "                        ) AS estimated_end_time\n",
    "                    FROM trips t\n",
    "\n",
    "                    JOIN (\n",
    "                        SELECT\n",
    "                            trip_id,\n",
    "                            point_idx\n",
    "                        FROM points p\n",
    "                        WHERE NOT EXISTS (\n",
    "                            SELECT 1\n",
    "                            FROM points p2\n",
    "                            WHERE p2.trip_id = p.trip_id\n",
    "                            AND p2.point_idx > p.point_idx\n",
    "                        )\n",
    "                    ) AS last_point\n",
    "                        ON t.trip_id = last_point.trip_id\n",
    "\n",
    "                    WHERE t.missing_data = 0\n",
    "                    AND DATE(t.start_time) <\n",
    "                        DATE(\n",
    "                            DATE_ADD(\n",
    "                                t.start_time,\n",
    "                                INTERVAL last_point.point_idx * 15 SECOND\n",
    "                            )\n",
    "                        )\n",
    "\n",
    "                    ORDER BY t.start_time\n",
    "                \"\"\"\n",
    "        self.cursor.execute(query)\n",
    "        midnight_crossers = self.cursor.fetchall()\n",
    "        print(tabulate(midnight_crossers[:10], headers=self.cursor.column_names))\n",
    "\n",
    "    def exercise_9(self):\n",
    "        query_fake = \"\"\" \n",
    "                    SELECT \n",
    "                        t.trip_id,\n",
    "                        start_point.latitude AS start_latitude,\n",
    "                        end_point.latitude AS end_latitude,\n",
    "                        start_point.longitude AS start_longitude,\n",
    "                        end_point.longitude AS end_longitude\n",
    "                    FROM trips t\n",
    "                    \n",
    "                    JOIN (\n",
    "                        SELECT\n",
    "                            trip_id,\n",
    "                            MIN(point_idx) as first_idx,\n",
    "                            MAX(point_idx) as last_idx\n",
    "                        FROM points\n",
    "                        GROUP BY trip_id\n",
    "                    ) point_indices\n",
    "                        ON t.trip_id = point_indices.trip_id\n",
    "                    \n",
    "                    JOIN points start_point\n",
    "                        ON start_point.trip_id = point_indices.trip_id\n",
    "                        AND start_point.point_idx = point_indices.first_idx\n",
    "\n",
    "                    JOIN points end_point\n",
    "                        ON end_point.trip_id = point_indices.trip_id\n",
    "                        AND end_point.point_idx = point_indices.last_idx\n",
    "\n",
    "                    WHERE missing_data = 0\n",
    "                \"\"\"\n",
    "\n",
    "        query = \"\"\"\n",
    "                    SELECT\n",
    "                        t.trip_id,\n",
    "                        start_point.latitude AS start_latitude,\n",
    "                        start_point.longitude AS start_longitude,\n",
    "                        end_point.latitude AS end_latitude,\n",
    "                        end_point.longitude AS end_longitude\n",
    "                    FROM trips t\n",
    "\n",
    "                    JOIN points start_point\n",
    "                        ON start_point.trip_id = t.trip_id\n",
    "                        AND start_point.point_idx = 0\n",
    "\n",
    "                    JOIN points end_point\n",
    "                        ON end_point.trip_id = t.trip_id\n",
    "\n",
    "                    WHERE t.missing_data = 0\n",
    "\n",
    "                    AND NOT EXISTS (\n",
    "                        SELECT 1\n",
    "                        FROM points later_point\n",
    "                        WHERE later_point.trip_id = end_point.trip_id\n",
    "                            AND later_point.point_idx > end_point.point_idx\n",
    "                    )\n",
    "                \"\"\"\n",
    "\n",
    "        self.cursor.execute(query)\n",
    "        data = self.cursor.fetchall()\n",
    "        circular_trips = []\n",
    "        for row in data:\n",
    "            start_point = (row[1], row[2])\n",
    "            end_point = (row[3], row[4])\n",
    "\n",
    "            distance = hv.haversine(start_point, end_point, unit=\"m\")\n",
    "\n",
    "            if distance <= 50:\n",
    "                circular_trips.append((\n",
    "                    row[0],\n",
    "                    row[1],\n",
    "                    row[2],\n",
    "                    row[3],\n",
    "                    row[4],\n",
    "                    distance\n",
    "                ))\n",
    "\n",
    "        print(f\"Circual trip count: {len(circular_trips)}\")\n",
    "        for trip in circular_trips[:20]:\n",
    "            print(trip)\n",
    "    \n",
    "    def exercise_10(self):\n",
    "            query = \"\"\"\n",
    "                        WITH trip_times AS (\n",
    "                            SELECT\n",
    "                                t.trip_id,\n",
    "                                t.taxi_id,\n",
    "                                t.start_time,\n",
    "                                DATE_ADD(\n",
    "                                    t.start_time,\n",
    "                                    INTERVAL (\n",
    "                                        SELECT MAX(p.point_idx) * 15\n",
    "                                        FROM points p\n",
    "                                        WHERE p.trip_id = t.trip_id\n",
    "                                    ) SECOND\n",
    "                                ) AS end_time\n",
    "                            FROM trips t\n",
    "                            WHERE t.missing_data = 0\n",
    "                        ),\n",
    "    \n",
    "                        consecutive_trips AS (\n",
    "                            SELECT\n",
    "                                taxi_id,\n",
    "                                trip_id,\n",
    "                                start_time,\n",
    "                                end_time,\n",
    "                                LAG(end_time) OVER (\n",
    "                                    PARTITION BY taxi_id\n",
    "                                    ORDER BY start_time\n",
    "                                ) AS previous_end_time\n",
    "                            FROM trip_times\n",
    "                        )\n",
    "    \n",
    "                        SELECT\n",
    "                            taxi_id,\n",
    "                            AVG(\n",
    "                                TIMESTAMPDIFF(\n",
    "                                    SECOND,\n",
    "                                    previous_end_time,\n",
    "                                    start_time\n",
    "                                )\n",
    "                            ) / 60 AS average_idle_minutes\n",
    "                        FROM consecutive_trips\n",
    "                        WHERE previous_end_time IS NOT NULL\n",
    "                        AND start_time >= previous_end_time\n",
    "                        GROUP BY taxi_id\n",
    "                        ORDER BY average_idle_minutes DESC\n",
    "                        LIMIT 20\n",
    "                    \"\"\"\n",
    "    \n",
    "            self.cursor.execute(query)\n",
    "    \n",
    "            rows = self.cursor.fetchall()\n",
