    "                    f\"({count / total_rows * 100:.1f}%)\"\n",
    "                )\n",
    "\n",
    "                # Insert trips\n",
    "                self.cursor.executemany(\n",
    "                    trips_insert_query,\n",
    "                    trip_values\n",
    "                )\n",
    "\n",
    "                # Insert GPS points\n",
    "                if point_values:\n",
    "                    self.cursor.executemany(\n",
    "                        points_insert_query,\n",
    "                        point_values\n",
    "                    )\n",
    "\n",
    "                # Commit this batch\n",
    "                self.db_connection.commit()\n",
    "\n",
    "                # Clear batches\n",
    "                trip_values.clear()\n",
    "                point_values.clear()\n",
    "\n",
    "        print(\"Finished inserting data.\")\n",
    "\n",
    "    def fetch_data(self, table_name):\n",
